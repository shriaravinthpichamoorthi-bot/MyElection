# ── Supabase (keep your existing values) ──
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=eyJ-your-service-role-key-here

# ── Tamil Nadu (default — no changes needed) ──
# STATE_CODE=S22
# STATE_NAME=tamil nadu
# TOTAL_CONSTITUENCIES=234
# ELECTION_FOLDER=

# ── Bihar 2025 Testing ──
# Note: Bihar ECI state code is S04. The URL statewiseS041.htm = statewise + S04 + 1.htm
STATE_CODE=S04
STATE_NAME=bihar
TOTAL_CONSTITUENCIES=243
ELECTION_FOLDER=ResultAcGenNov2025

# ── Scraper Timing ──
REFRESH_INTERVAL_MINUTES=5
PAGE_LOAD_DELAY_SECONDS=3

# ── Browser ──
HEADLESS=false

# ── API ──
CORS_ORIGIN=*
ADMIN_SECRET=dev-secret-change-me

# ── Feature Toggles ──
# Set to true ONLY if you want fake TN mock data instead of real ECI data
ENABLE_MOCK_DATA=false
